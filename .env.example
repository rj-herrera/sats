# Copy this file to .env and fill in the database user and password.
# The tables read by the directory API are employee_list, group_list,
# and employee_group in this database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kdtphdb_new
DB_USER=
DB_PASS=

# SATS application database. Leave the user and password empty to reuse DB_USER and DB_PASS.
SATS_DB_HOST=127.0.0.1
SATS_DB_PORT=3306
SATS_DB_NAME=sats
SATS_DB_USER=
SATS_DB_PASS=

# Read-only portal login database. The userID cookie matches kdtlogin.fldUserHash.
LOGIN_DB_NAME=kdtphdb

# TESTING ONLY. Set to 1 to allow localhost employee-id sign-in. Remove with backend/DevLogin.php.
SATS_DEV_LOGIN=0
